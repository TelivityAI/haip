{
  "name": "@telivity/repo-control",
  "version": "0.1.0",
  "private": true,
  "description": "Repository Control board for Discord Activities (view-only) — snapshot analysis feeds the Activity origin",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "analyze": "tsx src/analyze.ts",
    "serve": "tsx src/server.ts",
    "dev": "tsx src/server.ts --dev",
    "build:ui": "vite build --config ui/vite.config.ts",
    "build": "pnpm build:ui && tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p ui/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node --import tsx src/server.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.24.0",
    "@clerk/clerk-js": "^6.39.0",
    "@discord/embedded-app-sdk": "^1.9.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "vite": "^6.0.0",
    "vitest": "^2.1.1"
  }
}
