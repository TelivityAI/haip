# --- Clerk (hosted contributor access: email sign-up / sign-in) ---
# From https://dashboard.clerk.com → API Keys. Never commit real values.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Optional: comma-separated owners who may refresh/annotate
# REPO_CONTROL_OWNER_EMAILS=you@example.com
# REPO_CONTROL_OWNER_USER_IDS=

# --- Discord Activity ---
REPO_CONTROL_DISCORD_PUBLIC_READ=true
DISCORD_CLIENT_ID=
VITE_DISCORD_CLIENT_ID=

# --- Optional owner token (operator) ---
REPO_CONTROL_AUTH_TOKEN=

PORT=8787
HOST=0.0.0.0
