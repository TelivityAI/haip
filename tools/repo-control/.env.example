# Owner browser auth (required in production).
# Put the real value only in a local .env or host secret store — never commit it.
REPO_CONTROL_AUTH_TOKEN=

# Allow read-only snapshot/UI for Discord Activity proxy (mutations still require auth)
REPO_CONTROL_DISCORD_PUBLIC_READ=false

# Optional: disable auth entirely (local only — never in production)
# REPO_CONTROL_AUTH_DISABLED=true

PORT=8787
HOST=0.0.0.0

# Optional Discord Application ID for Embedded App SDK
# VITE_DISCORD_CLIENT_ID=

# Config override
# REPO_CONTROL_CONFIG=config.haip.yaml
