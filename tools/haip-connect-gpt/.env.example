# --- Upstream HAIP Connect API ---
HAIP_API_BASE_URL=http://localhost:3000
HAIP_CONNECT_API_KEY=dev-connect-key

# --- This gateway (reference OSS adapter) ---
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# REQUIRED when exposing publicly — callers must present this.
GATEWAY_API_KEY=

# Optional attribution defaults for Connect bookings
# HAIP_AGENT_ID=HAIP_AGENT

# Optional static allow-list (comma-separated property UUIDs)
# ALLOWED_PROPERTY_IDS=00000000-0000-4000-a000-000000000001
# Local demos only:
# ALLOW_ALL_PROPERTIES=true

# Optional live allow-list API (service token)
# AI_DISTRIBUTION_BASE_URL=
# AI_DISTRIBUTION_SERVICE_TOKEN=

# --- Tool-call logging ---
TOOL_LOG_DATABASE_URL=
