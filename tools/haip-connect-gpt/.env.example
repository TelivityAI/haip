# --- Upstream HAIP Connect API ---
HAIP_API_BASE_URL=http://localhost:3000
HAIP_CONNECT_API_KEY=dev-connect-key

# --- This gateway ---
PORT=8080
PUBLIC_BASE_URL=http://localhost:8080

# REQUIRED in staging/prod — ChatGPT / Claude / Gemini callers must present this.
GATEWAY_API_KEY=

# --- Allow-list (opted-in properties) ---
# Prefer remote allow-list API (service token):
AI_DISTRIBUTION_BASE_URL=https://example.com
AI_DISTRIBUTION_SERVICE_TOKEN=
# Or static UUIDs (comma-separated) for local smoke:
# LIGARE_ALLOWED_PROPERTY_IDS=00000000-0000-4000-a000-000000000001
# Local Connect demos only (do not use in staging/prod):
# LIGARE_ALLOW_ALL=true

# --- Tool-call logging ---
TOOL_LOG_DATABASE_URL=
