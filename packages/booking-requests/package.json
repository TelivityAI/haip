{
  "name": "@telivityhaip/booking-requests",
  "version": "0.0.1",
  "description": "Optional HAIP booking-requests module (request-first direct booking)",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/TelivityAI/haip.git",
    "directory": "packages/booking-requests"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/database/schema/index.d.ts",
      "import": "./dist/database/schema/index.js",
      "require": "./dist/database/schema/index.cjs",
      "default": "./dist/database/schema/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "clean": "rm -rf dist",
    "lint": "eslint src/",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "test:coverage": "vitest run --coverage",
    "db:migrate": "tsx src/database/migrate.ts"
  },
  "dependencies": {
    "@telivityhaip/database": "workspace:*",
    "@telivityhaip/shared": "workspace:^",
    "decimal.js": "^10.4.3",
    "drizzle-orm": "^0.39.0"
  },
  "peerDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0"
  },
  "devDependencies": {
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@types/node": "^22.0.0",
    "eslint": "^9.0.0",
    "postgres": "^3.4.5",
    "tsx": "^4.19.0",
    "tsup": "^8.3.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
