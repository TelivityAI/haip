# CHANNEX_PROPERTY_ID=...
# Staging certification (prefer connection.config.baseUrl):
# CHANNEX_BASE_URL=https://staging.channex.io/api/v1
# Production:
# CHANNEX_BASE_URL=https://api.channex.io/api/v1
